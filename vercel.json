{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/transcribe",
      "dest": "/api/transcribe.py"
    },
    {
      "src": "/api/summarize",
      "dest": "/api/summarize.py"
    },
    {
      "src": "/api/insights/save",
      "dest": "/api/insights_save.py"
    },
    {
      "src": "/api/insights",
      "dest": "/api/insights_list.py"
    },
    {
      "src": "/api/insights/(.*)",
      "dest": "/api/insights_list.py"
    }
  ]
}
